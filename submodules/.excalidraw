      "link": null,
      "locked": false,
      "text": "menu.py\n\n# some logic that constantly asks from user\nfor instructions out of options it displays,\ngiven the option then it will \n\n* in some way * communicate with the rest of\nthe classes that this change needs to happen,\nfor example: \n1) make new maze and display it \n2) display / hide shortest path\n3) change wall colors and redraw\n4) set specific color to display the '42' pattern\n5) can be more optional commands\n6) exit?\nmaybe look into inquirer\nhttps://python-\ninquirer.readthedocs.io/en/latest/installation.ht\nml",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "XluXjGKj5jxFiW7j09Ft7",
      "originalText": "menu.py\n\n# some logic that constantly asks from user for instructions out of options it displays, given the option then it will \n\n* in some way * communicate with the rest of the classes that this change needs to happen, for example: \n1) make new maze and display it \n2) display / hide shortest path\n3) change wall colors and redraw\n4) set specific color to display the '42' pattern\n5) can be more optional commands\n6) exit?\nmaybe look into inquirer\nhttps://python-inquirer.readthedocs.io/en/latest/installation.html",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
