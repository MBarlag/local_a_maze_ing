      "isDeleted": false,
      "boundElements": [],
      "updated": 1793630969585,
      "created": 1792876749651,
      "link": null,
      "locked": false,
      "text": "if all of the 4 corners cant be found \nin the reversed\nit means that the 2x2 is valid, because it\nmeans that once we unreverse the 2x2, \nit will have walls in the middle",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if all of the 4 corners cant be found \nin the reversed\nit means that the 2x2 is valid, because it means that once we unreverse the 2x2, \nit will have walls in the middle",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
