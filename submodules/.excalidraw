      "updated": 1790778772052,
      "link": null,
      "locked": false,
      "text": "class Move(Enum):\n# Provides readable way to store wall states\n--------------------------------------------------\n     LEFT = (0, -1)\n     DOWN = (1, 0)\n    RIGHT = (0, 1)\n       UP = (-1, 0)\n  NOWHERE = (0, 0)\n--------------------------------------------------\n+ __iter__(self): Iterator(Move) -> Wall.N in wall",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "jkGh9TbaYXUf73RRHPOtl",
      "originalText": "class Move(Enum):\n# Provides readable way to store wall states\n--------------------------------------------------\n     LEFT = (0, -1)\n     DOWN = (1, 0)\n    RIGHT = (0, 1)\n       UP = (-1, 0)\n  NOWHERE = (0, 0)\n--------------------------------------------------\n+ __iter__(self): Iterator(Move) -> Wall.N in wall",
      "autoResize": true,
      "lineHeight": 1.25
    },
