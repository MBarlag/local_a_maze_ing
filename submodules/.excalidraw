      "created": 1792872303227,
      "link": null,
      "locked": false,
      "text": "for room in maze:\n    if len(room.walls) != 3:\n        continue\n    for wall in room.walls:\n        neighbour = room + wall.direction\n        if neighbour:\n            neighbour.walls -= wall.opposite\n            self.walls -= wall\n        if not maze.valid:\n            # undo our breaking",
      "fontSize": 35.80278015136719,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for room in maze:\n    if len(room.walls) != 3:\n        continue\n    for wall in room.walls:\n        neighbour = room + wall.direction\n        if neighbour:\n            neighbour.walls -= wall.opposite\n            self.walls -= wall\n        if not maze.valid:\n            # undo our breaking",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
