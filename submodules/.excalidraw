    {
      "id": "3LRIKikIpe76NE-9tqjRy",
      "type": "text",
      "x": -1949.3649190198223,
      "y": -901.9389723621632,
      "width": 676.09521484375,
      "height": 875,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "2PMapooio1SxNxo2GLmuA",
      "index": "b2PG",
      "roundness": null,
      "seed": 635140409,
      "version": 6384,
      "versionNonce": 793056023,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790950770685,
      "link": null,
      "locked": false,
      "text": "class Grid(Generic[T]):\n______________________________________________________________\n(description)\n\n# With the Grid class, we should be able to:\n    1. Return a row or column.\n    2. Run large scale methods that affect whole grid,\n        or that make sense more at the grid level than \n        at the cell level\n--------------------------------------------------------------\n(attributes)\n\ndefault: T\nheight: int\nwidth: int\n_grid: list[list[T]]\n--------------------------------------------------------------\n(methods)\n\n+ __init__(self, height: int, width: int, default: T)\n+ __iter__(self) -> Iterator[Cell[T]]\n+ property(cell) -> Cell[T]\n    return self._grid[0][0]\n+ property(valid) -> bool\n    return all([cell.valid for cell in self])\n+ cant_reach(y: int, x: int) -> bool\n..............................................................\n# stuff we might not need in maze, but maybe good to keep\nsince it's abstract class\n\n+ __getitem__(self, y) -> list[T]\n+ row(self, y: int) -> Iterator[T]\n+ column() -> Iterator[T]\n..............................................................\n--------------------------------------------------------------",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "WWGztZaqtw-9E-TZuScvU",
      "originalText": "class Grid(Generic[T]):\n______________________________________________________________\n(description)\n\n# With the Grid class, we should be able to:\n    1. Return a row or column.\n    2. Run large scale methods that affect whole grid,\n        or that make sense more at the grid level than \n        at the cell level\n--------------------------------------------------------------\n(attributes)\n\ndefault: T\nheight: int\nwidth: int\n_grid: list[list[T]]\n--------------------------------------------------------------\n(methods)\n\n+ __init__(self, height: int, width: int, default: T)\n+ __iter__(self) -> Iterator[Cell[T]]\n+ property(cell) -> Cell[T]\n    return self._grid[0][0]\n+ property(valid) -> bool\n    return all([cell.valid for cell in self])\n+ cant_reach(y: int, x: int) -> bool\n..............................................................\n# stuff we might not need in maze, but maybe good to keep since it's abstract class\n\n+ __getitem__(self, y) -> list[T]\n+ row(self, y: int) -> Iterator[T]\n+ column() -> Iterator[T]\n..............................................................\n--------------------------------------------------------------",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "XyZHDd1NVjOgM_SoRDQV8",
      "type": "rectangle",
      "x": -1230.7853051119373,
      "y": -907.3620389236972,
      "width": 677.9310999837667,
      "height": 1210,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
