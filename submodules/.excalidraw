      "isDeleted": false,
      "boundElements": [],
      "updated": 1788868337596,
      "link": null,
      "locked": false,
      "text": "menu.py\n\n# some logic that constantly asks from user\nfor instructions out of options it displays,\ngiven the option then it will \n\n* in some way * communicate with the rest of\nthe classes that this change needs to happen,\nfor example: \n1) make new maze and display it \n2) display / hide shortest path\n3) change wall colors and redraw\n4) set specific color to display the '42' pattern\n5) can be more optional commands\n6) exit?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "menu.py\n\n# some logic that constantly asks from user for instructions out of options it displays, given the option then it will \n\n* in some way * communicate with the rest of the classes that this change needs to happen, for example: \n1) make new maze and display it \n2) display / hide shortest path\n3) change wall colors and redraw\n4) set specific color to display the '42' pattern\n5) can be more optional commands\n6) exit?",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "OeJmGI2LUYZq94oshtxvM",
      "type": "frame",
      "x": -227.5904882276218,
      "y": -561.3617664633059,
      "width": 538.3037860576926,
      "height": 448.0715766319862,
      "angle": 0,
      "strokeColor": "#bbb",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
