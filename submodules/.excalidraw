      "updated": 1790953893481,
      "link": null,
      "locked": false,
      "text": "class Move(Enum):\n# Provides readable way to store wall states\n--------------------------------------------------\n     LEFT = (0, -1)\n     DOWN = (1, 0)\n    RIGHT = (0, 1)\n       UP = (-1, 0)\n  NOWHERE = (0, 0)\n--------------------------------------------------",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "jkGh9TbaYXUf73RRHPOtl",
      "originalText": "class Move(Enum):\n# Provides readable way to store wall states\n--------------------------------------------------\n     LEFT = (0, -1)\n     DOWN = (1, 0)\n    RIGHT = (0, 1)\n       UP = (-1, 0)\n  NOWHERE = (0, 0)\n--------------------------------------------------",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
