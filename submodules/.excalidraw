      "link": null,
      "locked": false,
      "text": "class Color(Flag):\n# Provides readable way to store colors\n--------------------------------------------------\n    RED = 0b111000000\n    GREEN = 0b000111000\n    BLUE = 0b000000111\n    WHITE = 0b000000000\n    BLACK = RED | GREEN | BLUE\n--------------------------------------------------",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "I7fYa8SJXpXXUMUnFCKvU",
      "originalText": "class Color(Flag):\n# Provides readable way to store colors\n--------------------------------------------------\n    RED = 0b111000000\n    GREEN = 0b000111000\n    BLUE = 0b000000111\n    WHITE = 0b000000000\n    BLACK = RED | GREEN | BLUE\n--------------------------------------------------",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1790953564484,
      "labelPosition": null,
      "baseFontSize": null
