      "seed": 227988357,
      "version": 5052,
      "versionNonce": 1094210210,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790953893481,
      "link": null,
      "locked": false,
      "text": "class Walls(Flag, Iterable):\n# Provides readable way to store wall states\nSupports addition and substruction to other enum or\nint\n--------------------------------------------------\n        W = 1000\n        S = 0100\n        E = 0010\n        N = 0001\n    BLOCK = 1111\n    EMPTY = 0000\n--------------------------------------------------\n+ __iter__(self): Iterator(Wall) -> Wall.N in wall\n+ property(oppostite): Wall \n    -> Wall.N.opposite == Wall.S etc\n+ __add__(self, other: Flag | int)\n+ __radd__\n+ __sub__\n+ __rsub__",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "qG-ImzPh0tpDT4ap_vmiY",
      "originalText": "class Walls(Flag, Iterable):\n# Provides readable way to store wall states\nSupports addition and substruction to other enum or int\n--------------------------------------------------\n        W = 1000\n        S = 0100\n        E = 0010\n        N = 0001\n    BLOCK = 1111\n    EMPTY = 0000\n--------------------------------------------------\n+ __iter__(self): Iterator(Wall) -> Wall.N in wall\n+ property(oppostite): Wall \n    -> Wall.N.opposite == Wall.S etc\n+ __add__(self, other: Flag | int)\n+ __radd__\n+ __sub__\n+ __rsub__",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "jkGh9TbaYXUf73RRHPOtl",
