    {
      "id": "EsqQXuGn-UyQpNNtmnT-y",
      "type": "text",
      "x": -782.8002849724901,
      "y": -42.29247753622167,
      "width": 538.999267578125,
      "height": 425,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
