      "isDeleted": false,
      "boundElements": [],
      "updated": 1791309332123,
      "link": null,
      "locked": false,
      "text": "def gen_solution(current_cell: Cell):\n    legal_moves = [Move.RIGHT]\nif  current_cell.is_exit no legal_moves or maze.valid == False:\n    return Halted\nfor move in shuffle(legal_moves):\n    return gen_maze(current_cell + random(legal_moves))\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def gen_solution(current_cell: Cell):\n    legal_moves = [Move.RIGHT]\nif  current_cell.is_exit no legal_moves or maze.valid == False:\n    return Halted\nfor move in shuffle(legal_moves):\n    return gen_maze(current_cell + random(legal_moves))\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
