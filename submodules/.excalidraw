      "index": "b0a",
      "roundness": null,
      "seed": 252204441,
      "version": 3915,
      "versionNonce": 934424838,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790779062003,
      "link": null,
      "locked": false,
      "text": "class Cell[T](ABS, Callable)\n# Is a higher class access point for Maze\n# Is Lightweight\n# Only exists when needs to run operations from\nperspective of a cell, or compare cells\n# Is basically proxy of Grid for more low scale\nmanipulations and separation of scopes.\nThey have to have the same type T in order to be\nable to work.\n-------------------------------------------------\nmagic_property based on T here?\n-------------------------------------------------\n+ property(valid): bool\n+ __init__(self, _grid: Grid[T])\n+ __call__(self, y: int, x: int) -> self\n+ __iter__(self): Iterator[T]\n+ neighbour(self, m: Move) -> Cell[T]",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "XyZHDd1NVjOgM_SoRDQV8",
      "originalText": "class Cell[T](ABS, Callable)\n# Is a higher class access point for Maze\n# Is Lightweight\n# Only exists when needs to run operations from\nperspective of a cell, or compare cells\n# Is basically proxy of Grid for more low scale\nmanipulations and separation of scopes.\nThey have to have the same type T in order to be able to work.\n-------------------------------------------------\nmagic_property based on T here?\n-------------------------------------------------\n+ property(valid): bool\n+ __init__(self, _grid: Grid[T])\n+ __call__(self, y: int, x: int) -> self\n+ __iter__(self): Iterator[T]\n+ neighbour(self, m: Move) -> Cell[T]",
      "autoResize": true,
      "lineHeight": 1.25
    },
