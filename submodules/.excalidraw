      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "ORzjoLam4eUksmuASzfnJ",
      "originalText": "class Maze\n# Starts with only walls and slowly gets changed by MazeGen, while validating. Ends as validated maze. (Validate its structure according to subject criteria of a valid maze.)\n# Machinery representation in our project that is easy to interact with\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
