    {
      "id": "L5qXUIhgX99NCaX7Bnpk7",
      "type": "text",
      "x": -2705.7621433416452,
      "y": 546.2608883221355,
      "width": 556.1428833007812,
      "height": 475,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
