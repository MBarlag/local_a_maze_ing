      "boundElements": [],
      "updated": 1793630697367,
      "link": null,
      "locked": false,
      "text": "class MazeGen(BaseModel):\n    height     : int\n    width      : int\n    perfect    : bool\n    entry      : Vector[int]\n    exit       : Vector[int]\n    output_file: str\n    seed       : int\n\n# it has all of the needed data to be\nable to generate the maze that we need\n# it should have a method that we call\nthat is gonna do the generation (its\ngonnabe its main contact point with other\nparts of program, so basically => main\ninterface)\n\n1. Break walls of a specific cell.\n1.1 Break mirroring walls.\n2. Do algorithms to know which wall to\nbreak.\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "G2Q54kd1ZeNFT09K-0yMv",
      "originalText": "class MazeGen(BaseModel):\n    height     : int\n    width      : int\n    perfect    : bool\n    entry      : Vector[int]\n    exit       : Vector[int]\n    output_file: str\n    seed       : int\n\n# it has all of the needed data to be able to generate the maze that we need\n# it should have a method that we call that is gonna do the generation (its gonnabe its main contact point with other parts of program, so basically => main interface)\n\n1. Break walls of a specific cell.\n1.1 Break mirroring walls.\n2. Do algorithms to know which wall to break.\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
