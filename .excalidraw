    {
      "id": "JkKPUtKKFtSYwaKmqYz-r",
      "type": "text",
      "x": 2.6021957316596627,
      "y": 1091.8010354070416,
      "width": 506,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
