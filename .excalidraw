    },
    {
      "id": "AfAtrJVUjLgv1FkAaRR8z",
      "type": "text",
      "x": 537.4771960423003,
      "y": -914.8517620871995,
      "width": 494.5479514382103,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "dHsA8t8fCmX5ijkzUgZ2U",
      "index": "b1MV",
      "roundness": null,
      "seed": 1828295841,
      "version": 200,
      "versionNonce": 1240789377,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788792796691,
      "link": null,
      "locked": false,
      "text": "main.py\n# responsible for being a dispatcher tower for all\nof the classes in the program,\nthe orchestrator, \n\nIt will talk with multiple classes and ask them to\ndo their job, without overwhelming each of the\nclass with information that is not needed\n\n\n\nconfig = config.parse_config(\"config.txt\")\n# config looks like: {'height': '4', ...}\n\nmaze_gen = MazeGen(**config)\n# under the hood it will call the MazeGen\nconstructor method, it will look something like\nthis:\n\nMazeGen(name=\"maze_name\", height=\"4\",\ncolor='red') \n# it will not care about parameters that are not\ndefined in its class and will just take what it\nactually needs",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "main.py\n# responsible for being a dispatcher tower for all of the classes in the program,\nthe orchestrator, \n\nIt will talk with multiple classes and ask them to do their job, without overwhelming each of the class with information that is not needed\n\n\n\nconfig = config.parse_config(\"config.txt\")\n# config looks like: {'height': '4', ...}\n\nmaze_gen = MazeGen(**config)\n# under the hood it will call the MazeGen constructor method, it will look something like this:\n\nMazeGen(name=\"maze_name\", height=\"4\", color='red') \n# it will not care about parameters that are not defined in its class and will just take what it actually needs",
      "autoResize": false,
      "lineHeight": 1.25
    },
