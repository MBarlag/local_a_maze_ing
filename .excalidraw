      "seed": 1279519234,
      "version": 2711,
      "versionNonce": 740957214,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788794192759,
      "link": null,
      "locked": false,
      "text": "class Maze\n# Has the walls and path generated in MazeGen\n# Machinery representation in our project that\nis easy to interact with\n# Validate its structure according to subject\ncriteria of a valid maze\n\n\n\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
